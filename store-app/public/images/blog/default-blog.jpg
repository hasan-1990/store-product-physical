<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="gradDefault" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#74b9ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0984e3;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#gradDefault)"/>
  
  <!-- Blog icon -->
  <g transform="translate(300, 120)">
    <rect x="0" y="0" width="200" height="160" rx="20" fill="white" opacity="0.9"/>
    <rect x="20" y="20" width="160" height="20" rx="5" fill="#ddd"/>
    <rect x="20" y="50" width="120" height="15" rx="3" fill="#ddd"/>
    <rect x="20" y="75" width="140" height="15" rx="3" fill="#ddd"/>
    <rect x="20" y="100" width="100" height="15" rx="3" fill="#ddd"/>
    <rect x="20" y="125" width="130" height="15" rx="3" fill="#ddd"/>
  </g>
  
  <text x="400" y="320" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="28" font-weight="bold">مقاله بلاگ</text>
  <text x="400" y="350" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="16" opacity="0.9">فروشگاه هاب</text>
</svg>