<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff9a9e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fecfef;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#grad5)"/>
  
  <!-- Trending arrows and charts -->
  <g transform="translate(200, 100)">
    <!-- Chart bars -->
    <rect x="0" y="60" width="30" height="40" fill="white" opacity="0.9"/>
    <rect x="40" y="40" width="30" height="60" fill="white" opacity="0.9"/>
    <rect x="80" y="20" width="30" height="80" fill="white" opacity="0.9"/>
    <rect x="120" y="10" width="30" height="90" fill="white" opacity="0.9"/>
    
    <!-- Trend arrow -->
    <path d="M 200 80 L 350 30 L 340 40 L 350 30 L 340 20" stroke="white" stroke-width="4" fill="none"/>
    <circle cx="350" cy="30" r="8" fill="white"/>
    
    <!-- 2024 badge -->
    <rect x="280" y="120" width="80" height="30" rx="15" fill="white" opacity="0.9"/>
    <text x="320" y="140" text-anchor="middle" fill="#ff6b6b" font-family="Arial, sans-serif" font-size="16" font-weight="bold">۱۴۰۳</text>
  </g>
  
  <text x="400" y="280" text-anchor="middle" fill="#333" font-family="Arial, sans-serif" font-size="24" font-weight="bold">ترندهای خرید آنلاین</text>
  <text x="400" y="310" text-anchor="middle" fill="#666" font-family="Arial, sans-serif" font-size="16">جدیدترین روندها در سال ۱۴۰۳</text>
</svg>