<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad8" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f093fb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f5576c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#grad8)"/>
  
  <!-- Headphones and earphones -->
  <g transform="translate(200, 80)">
    <!-- Over-ear headphones -->
    <g transform="translate(0, 0)">
      <path d="M 50 40 Q 100 0, 150 40" stroke="white" stroke-width="8" fill="none"/>
      <circle cx="40" cy="80" r="35" fill="white" opacity="0.9"/>
      <circle cx="160" cy="80" r="35" fill="white" opacity="0.9"/>
      <circle cx="40" cy="80" r="25" fill="#333"/>
      <circle cx="160" cy="80" r="25" fill="#333"/>
      <path d="M 40 115 Q 40 140, 50 140" stroke="white" stroke-width="6" fill="none"/>
      <path d="M 160 115 Q 160 140, 150 140" stroke="white" stroke-width="6" fill="none"/>
    </g>
    
    <!-- Earbuds -->
    <g transform="translate(250, 40)">
      <circle cx="0" cy="0" r="20" fill="white" opacity="0.9"/>
      <circle cx="0" cy="0" r="12" fill="#333"/>
      <line x1="0" y1="20" x2="0" y2="60" stroke="white" stroke-width="3"/>
      
      <circle cx="60" cy="0" r="20" fill="white" opacity="0.9"/>
      <circle cx="60" cy="0" r="12" fill="#333"/>
      <line x1="60" y1="20" x2="60" y2="60" stroke="white" stroke-width="3"/>
      
      <!-- Case -->
      <rect x="10" y="80" width="40" height="25" rx="12" fill="white" opacity="0.9"/>
    </g>
  </g>
  
  <!-- Sound waves -->
  <g transform="translate(400, 200)" opacity="0.6">
    <circle cx="0" cy="0" r="30" stroke="white" stroke-width="3" fill="none"/>
    <circle cx="0" cy="0" r="50" stroke="white" stroke-width="2" fill="none"/>
    <circle cx="0" cy="0" r="70" stroke="white" stroke-width="1" fill="none"/>
  </g>
  
  <text x="400" y="350" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="24" font-weight="bold">راهنمای خرید هدفون و ایرپاد</text>
</svg>