<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad7" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b6b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ee5a52;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#grad7)"/>
  
  <!-- Gaming laptop illustration -->
  <g transform="translate(150, 100)">
    <!-- Laptop base -->
    <rect x="0" y="120" width="500" height="40" rx="20" fill="white" opacity="0.9"/>
    <rect x="20" y="100" width="460" height="20" rx="10" fill="white" opacity="0.7"/>
    
    <!-- Screen -->
    <rect x="50" y="0" width="400" height="250" rx="15" fill="white" opacity="0.9"/>
    <rect x="70" y="20" width="360" height="210" rx="10" fill="#333"/>
    
    <!-- Screen content (gaming scene) -->
    <rect x="80" y="30" width="340" height="190" rx="5" fill="#0a0a0a"/>
    <circle cx="250" cy="125" r="40" fill="#ff6b6b" opacity="0.7"/>
    <circle cx="200" cy="100" r="25" fill="#4CAF50" opacity="0.8"/>
    <circle cx="300" cy="150" r="30" fill="#2196F3" opacity="0.8"/>
    <text x="250" y="135" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="16" font-weight="bold">GAMING</text>
    
    <!-- Keyboard keys -->
    <g fill="white" opacity="0.6">
      <rect x="60" y="270" width="20" height="15" rx="2"/>
      <rect x="90" y="270" width="20" height="15" rx="2"/>
      <rect x="120" y="270" width="20" height="15" rx="2"/>
      <rect x="150" y="270" width="60" height="15" rx="2"/>
    </g>
  </g>
  
  <text x="400" y="370" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="24" font-weight="bold">مقایسه لپ‌تاپ‌های گیمینگ</text>
</svg>