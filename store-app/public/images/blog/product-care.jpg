<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffecd2;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fcb69f;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#grad4)"/>
  
  <!-- Product care icons -->
  <g transform="translate(200, 100)">
    <!-- Box -->
    <rect x="0" y="40" width="100" height="80" rx="5" fill="white" opacity="0.9"/>
    <rect x="10" y="30" width="80" height="20" fill="white" opacity="0.7"/>
    <line x1="20" y1="40" x2="80" y2="40" stroke="#333" stroke-width="2"/>
    
    <!-- Shield -->
    <path d="M 150 40 Q 150 20, 200 40 Q 200 20, 250 40 L 250 90 Q 200 120, 150 90 Z" fill="white" opacity="0.9"/>
    <text x="200" y="80" text-anchor="middle" fill="#4CAF50" font-family="Arial, sans-serif" font-size="20" font-weight="bold">✓</text>
    
    <!-- Care symbol -->
    <circle cx="350" cy="80" r="40" fill="white" opacity="0.9"/>
    <path d="M 330 80 Q 350 60, 370 80 Q 350 100, 330 80" fill="#ff6b6b"/>
  </g>
  
  <text x="400" y="280" text-anchor="middle" fill="#333" font-family="Arial, sans-serif" font-size="24" font-weight="bold">نگهداری محصولات</text>
  <text x="400" y="310" text-anchor="middle" fill="#666" font-family="Arial, sans-serif" font-size="16">بهترین روش‌های نگهداری</text>
</svg>