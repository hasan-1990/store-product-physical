# ==============================================
# سیستم ارسال ایمیل - Email System Configuration
# ==============================================

# فعال/غیرفعال کردن سیستم ایمیل
EMAIL_ENABLED=false

# تنظیمات SMTP Server
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# اطلاعات فرستنده
EMAIL_FROM_NAME=فروشگاه آنلاین
EMAIL_FROM_ADDRESS=noreply@yourstore.com

# لوگوی ایمیل (URL)
EMAIL_LOGO_URL=https://yourstore.com/logo.png

# اطلاعات پشتیبانی
EMAIL_SUPPORT_EMAIL=support@yourstore.com
EMAIL_SUPPORT_PHONE=021-12345678

# ==============================================
# راهنمای تنظیمات SMTP
# ==============================================

# Gmail:
# 1. فعال‌سازی "Less secure app access" یا استفاده از "App Password"
# 2. EMAIL_HOST=smtp.gmail.com
# 3. EMAIL_PORT=587
# 4. EMAIL_SECURE=false

# Outlook/Hotmail:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Yahoo:
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Private SMTP (مثلاً cPanel):
# EMAIL_HOST=mail.yourdomain.com
# EMAIL_PORT=465
# EMAIL_SECURE=true

# ==============================================
# نکات امنیتی
# ==============================================
# 1. هرگز این فایل را commit نکنید!
# 2. برای Gmail حتماً از App Password استفاده کنید
# 3. رمز عبور ایمیل واقعی را استفاده نکنید
# 4. در production از SMTP معتبر استفاده کنید
