{
  "name": "store-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "patch-package",
    "db:seed": "node scripts/seed-dynamic-content.js",
    "build:production": "npm run build",
    "deploy:check": "node scripts/validate-deploy-env.js",
    "deploy:check:prod": "node scripts/validate-deploy-env.js --env .env.production",
    "deploy:rebuild": "docker compose build --no-cache core-server",
    "deploy:up": "docker compose up -d --build core-server nginx",
    "deploy:next-dev": "docker compose -f docker-compose.next-dev.yml up -d --build app",
    "core:dev": "tsx watch --env-file=.env.local --env-file=.env packages/core-server/src/server.ts",
    "core:start": "tsx --env-file=.env.local --env-file=.env packages/core-server/src/server.ts",
    "templates:sync": "tsx scripts/register-site-templates.ts",
    "verify:bugs": "tsx scripts/verify-bug-fixes.ts",
    "verify:polish": "tsx scripts/verify-polish-q3.ts",
    "verify:scale": "tsx scripts/verify-scale-q4.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "perf:audit": "tsx scripts/perf-audit.ts",
    "db:backup": "tsx scripts/run-mongodb-backup.ts",
    "scale:seed": "node scripts/seed-scale-defaults.js",
    "analyze": "ANALYZE=true npm run build",
    "bundle-analyzer": "npx @next/bundle-analyzer"
  },
