# ==============================================
# Example Environment Variables
# ==============================================
# 📝 Copy this file to .env.local for development
# 📝 Copy this file to .env.production for production
# 🔒 Never commit .env.local or .env.production to Git
# ==============================================

# ==============================================
# MongoDB Configuration
# ==============================================
# Local MongoDB (for development only)
# DATABASE_URL=mongodb://localhost:27017/store-app
# MONGODB_URI=mongodb://localhost:27017/store-app

# MongoDB Atlas (Cloud - Recommended for Production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/store-app?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/store-app?retryWrites=true&w=majority

# ==============================================
# Redis Configuration (Optional - for caching)
# ==============================================
REDIS_ENABLED=false
# If enabled:
# REDIS_URL=redis://localhost:6379

# ==============================================
# Next Rocket (Performance Module)
# ==============================================
NEXT_ROCKET_ENABLED=false
# NEXT_PUBLIC_NEXT_ROCKET_ENABLED=false

# ==============================================
# Q4 Scale — CDN, Monitoring, Backup
# ==============================================
# CDN برای _next/static (اختیاری — Nginx هم uploads را cache می‌کند)
# CDN_URL=https://cdn.yourdomain.com
# NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com
# CDN_UPLOADS_URL=https://cdn.yourdomain.com

# Sentry (اختیاری)
# SENTRY_DSN=https://key@o0.ingest.sentry.io/projectId

# نگهداری بک‌آپ (روز)
BACKUP_RETENTION_DAYS=30
# Or with authentication:
# REDIS_URL=redis://username:password@host:port

# ==============================================
# NextAuth Configuration
# ==============================================
# Generate secure secret: openssl rand -base64 64
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-this-minimum-32-characters
NEXTAUTH_URL=http://localhost:3000

# ==============================================
# JWT Secret
# ==============================================
# Generate secure secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ==============================================
# API & Application URLs (Split: Express API + Next UI)
# ==============================================
CORE_SERVER_PORT=4000
CORE_API_URL=http://localhost:4000
# Next dev proxies /api → CORE_API_URL when NEXT_PROXY_API_TO_CORE=true (default in dev)
NEXT_PROXY_API_TO_CORE=true
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_NAME=فروشگاه آنلاین

# ==============================================
# SMS.ir Configuration (Iranian SMS Service)
# ==============================================
SMSIR_API_KEY=your_smsir_api_key_here
SMSIR_LINE_NUMBER=09123456789

# SMS Template IDs (Define in SMS.ir panel first)
SMS_IR_VERIFICATION_TEMPLATE_ID=123456
SMS_IR_ORDER_CONFIRMATION_TEMPLATE_ID=123457
SMS_IR_PASSWORD_RESET_TEMPLATE_ID=123458
SMS_IR_ACCOUNT_ACTIVATION_TEMPLATE_ID=123459

# ==============================================
# Email Configuration (Gmail SMTP Example)
# ==============================================
EMAIL_ENABLED=true

# SMTP Server Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
# For Gmail: Use App Password from https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-gmail-app-password

# Email Sender Information
EMAIL_FROM_NAME=فروشگاه آنلاین
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_LOGO_URL=http://localhost:3000/logo.png

# Support Contact Info
EMAIL_SUPPORT_EMAIL=support@yourdomain.com
EMAIL_SUPPORT_PHONE=021-12345678

# ==============================================
# Google Analytics & Tracking
# ==============================================
# Google Analytics 4 (GA4)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Tag Manager (GTM)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Search Console Verification
NEXT_PUBLIC_GSC_VERIFICATION=your-google-verification-code

# ==============================================
# Payment Gateway Configuration - Zarinpal
# ==============================================
# ℹ️  برای دریافت Merchant ID به https://www.zarinpal.com بروید
# ℹ️  پس از ثبت نام و احراز هویت، کد مرچنت 36 کاراکتری دریافت کنید
# ℹ️  فرمت: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Zarinpal Merchant ID (کد 36 کاراکتری)
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Zarinpal Sandbox Mode (برای تست)
# true = حالت تست (بدون پرداخت واقعی)
# false = حالت واقعی (پرداخت واقعی)
ZARINPAL_SANDBOX=true

# مثال Merchant ID واقعی:
# ZARINPAL_MERCHANT_ID=12345678-1234-1234-1234-123456789012

# ==============================================
# Payment Gateway Configuration - Zibal
# ==============================================
# ℹ️  برای دریافت Merchant و API Token به https://panel.zibal.ir بروید
# ℹ️  Merchant: نام تجاری شما در سیستم Zibal
# ℹ️  API Token: برای احراز هویت بهتر (اختیاری)

# Zibal Merchant (نام تجاری)
ZIBAL_MERCHANT=zibal

# Zibal API Token (اختیاری - برای احراز هویت)
ZIBAL_API_KEY=your-zibal-api-token-here

# مثال تنظیمات واقعی:
# ZIBAL_MERCHANT=myshop
# ZIBAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# Payment Gateway - Other Options (غیرفعال)
# ==============================================
# IDPay (Alternative Iranian Gateway)
# IDPAY_API_KEY=your-idpay-api-key
# IDPAY_SANDBOX_MODE=true

# Mellat Bank Gateway
# MELLAT_TERMINAL_ID=your-terminal-id
# MELLAT_USERNAME=your-username
# MELLAT_PASSWORD=your-password

# ==============================================
# File Upload Settings
# ==============================================
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ==============================================
# Security & Rate Limiting
# ==============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# Maintenance Mode
# ==============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=سایت در حال بروزرسانی است. لطفاً چند دقیقه دیگر مراجعه کنید.

# ==============================================
# Cache Configuration
# ==============================================
CACHE_ENABLED=true
CACHE_TTL=3600

# ==============================================
# Feature Flags (Enable/Disable Features)
# ==============================================
FEATURE_WISHLIST=true
FEATURE_REVIEWS=true
FEATURE_BLOG=true
FEATURE_DISCOUNT_CODES=true
FEATURE_AB_TESTING=true

# ==============================================
# Logging & Monitoring
# ==============================================
# Log levels: debug, info, warn, error
LOG_LEVEL=debug

# Sentry Error Tracking (Optional)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==============================================
# Build & Development
# ==============================================
NODE_ENV=development
ANALYZE=false

# ==============================================
# AI Provider Keys (example placeholders)
# Set at least one provider key (or use Claude Code / Codex CLI)
# For Gemini: Taskmaster often expects GOOGLE_API_KEY (and/or GEMINI_API_KEY)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Anthropic (Claude)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# OpenAI (GPT)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Perplexity (research)
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY_HERE

# xAI
XAI_API_KEY=YOUR_XAI_API_KEY_HERE

# OpenRouter
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# ==============================================
# Site Provisioning (Managed Site Templates)
# ==============================================
# SERVER_PUBLIC_IP=YOUR_SERVER_IP
# PROVISION_PORT_START=3001
# MAX_PROVISIONED_INSTANCES=100
# PROVISIONING_ENABLED=true
# AUTO_SSL=true

# ==============================================
# Security (Production)
# ==============================================
# Never set to true in production — blocks /api/debug/* and /api/test-*
# ALLOW_DEV_ROUTES=false

# Force maintenance page for all non-admin users (also works via admin settings cookie)
# MAINTENANCE_MODE=false

# ==============================================
# SETUP INSTRUCTIONS
# ==============================================
# 1. Copy this file to .env.local for local development
# 2. Replace all placeholder values with actual credentials
# 3. Generate secure secrets:
#    - NEXTAUTH_SECRET: openssl rand -base64 64
#    - JWT_SECRET: openssl rand -base64 32
# 4. For production, copy to .env.production and update URLs
# 5. Never commit .env.local or .env.production to version control
# ==============================================
